{
  "name": "aicallassistant",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "AI Call Assistant v4 — push-to-record call copilot for Windows",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
